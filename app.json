{
  "expo": {
    "name": "fennoc-app",
    "slug": "fennoc-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-foreground.png",
        "monochromeImage": "./assets/icon-monochrome.png",
        "backgroundColor": "#100E0B"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fennoc.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/ic-stat-fennoc.png",
          "color": "#F0A93B"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3d72b632-8e12-41c5-8095-8c56bd5d1b6c"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3d72b632-8e12-41c5-8095-8c56bd5d1b6c"
    }
  }
}
